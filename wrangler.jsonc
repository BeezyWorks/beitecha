{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beitecha",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Served at beitecha.baderech.app (the zone baderech.app is on Cloudflare).
  "routes": [{ "pattern": "beitecha.baderech.app", "custom_domain": true }],
  "build": { "command": "pnpm build:web" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/*.ics"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beitecha",
      "database_id": "e0d4eae9-0272-4521-ba7e-a66df9e18c99",
      "migrations_dir": "migrations"
    }
  ],
  // Sessions are checked against the accounts Worker over a service binding.
  "services": [{ "binding": "AUTH", "service": "beezyworks-accounts" }],
  // Per-IP limit on the public reads (feed, directory, ICS). Generous: a whole minyan may scan the QR code from the
  // shul's wifi at once.
  "ratelimits": [{ "name": "PUBLIC_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "vars": {
    "AUTH_URL": "https://auth.baderech.app",
    "PUBLIC_URL": "https://beitecha.baderech.app"
  }
}
