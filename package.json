{
  "name": "beitecha",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "start": "expo start --web",
    "build:web": "expo export --platform web",
    "dev:api": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply beitecha --local",
    "db:migrate:remote": "wrangler d1 migrations apply beitecha --remote",
    "test": "pnpm -r --filter ./packages/engine --filter ./worker test && jest",
    "typecheck": "tsc --noEmit && pnpm -r --filter ./packages/engine --filter ./worker typecheck",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@beezyworks/design": "workspace:*",
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/frank-ruhl-libre": "^0.4.1",
    "@expo-google-fonts/noto-rashi-hebrew": "^0.4.2",
    "@expo-google-fonts/noto-serif-hebrew": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@hebcal/core": "^6.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-spring/native": "^10.1.2",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^1.44.0",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1268.0",
    "react-native-collapsible-header-views": "^1.1.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15",
    "@beitecha/engine": "workspace:*",
    "@expo-google-fonts/crimson-pro": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/libre-baskerville": "^0.4.3",
    "@expo-google-fonts/source-serif-4": "^0.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.40.0"
  }
}
